# Backend (API)
ROBOCHESS_MODEL_PATH=backend/models/best.pt
ROBOCHESS_STOCKFISH_PATH=backend/stockfish/stockfish-windows-x86-64-avx2.exe
ROBOCHESS_CAMERA_INDEX=0
ROBOCHESS_CAPTURE_WIDTH=820
ROBOCHESS_CAPTURE_HEIGHT=620
ROBOCHESS_CONFIDENCE=0.05
ROBOCHESS_DET_CONF=0.10
ROBOCHESS_MATCH_MIN=54
ROBOCHESS_MATCH_GAP=2
ROBOCHESS_START_MISSING=16
ROBOCHESS_START_EXTRA=6
ROBOCHESS_ENGINE_TIME=0.50
ROBOCHESS_CAMERA_JPEG_QUALITY=80

ROBOCHESS_MONGODB_URI=mongodb://localhost:27017
ROBOCHESS_MONGODB_DB=robochess

ROBOCHESS_JWT_SECRET=change-me
ROBOCHESS_JWT_ALG=HS256
ROBOCHESS_ACCESS_MINUTES=30
ROBOCHESS_REFRESH_DAYS=30
ROBOCHESS_DEVICE_TOKEN_MINUTES=1440
ROBOCHESS_PAIRING_CODE_MINUTES=5
ROBOCHESS_BLE_PAIR_MINUTES=5
ROBOCHESS_LOCAL_PAIR_CODE=000000

ROBOCHESS_RATE_LIMIT_REQUESTS=60
ROBOCHESS_RATE_LIMIT_WINDOW=60

ROBOCHESS_REDIS_URL=
ROBOCHESS_REDIS_CHANNEL=robochess_ws

ROBOCHESS_LOG_LEVEL=INFO

# Pi agent
ROBOCHESS_API_BASE=http://localhost:8000
ROBOCHESS_WS_BASE=ws://localhost:8000/ws
ROBOCHESS_DEVICE_ID=
ROBOCHESS_DEVICE_SECRET=
ROBOCHESS_HEARTBEAT_SECONDS=10
ROBOCHESS_LOCAL_API_HOST=0.0.0.0
ROBOCHESS_LOCAL_API_PORT=8765
ROBOCHESS_LOCAL_STATE_PATH=/var/lib/robochess/state
ROBOCHESS_INTERNET_CHECK_ENABLED=1
ROBOCHESS_INTERNET_CHECK_URL=https://connectivitycheck.gstatic.com/generate_204
ROBOCHESS_INTERNET_CHECK_TIMEOUT_SECONDS=5
ROBOCHESS_INTERNET_CHECK_INTERVAL_SECONDS=30

# Local YOLO weights are used automatically when Roboflow is unavailable.
# The repository does not include trained weights; provide this path at deploy time.
ROBOCHESS_MODEL_PATH=backend/models/best.pt

# Roboflow cloud inference is preferred when enabled and reachable.
ROBOCHESS_ROBOFLOW_ENABLED=0
ROBOCHESS_ROBOFLOW_MODEL_URL=
ROBOCHESS_ROBOFLOW_API_KEY=
ROBOCHESS_ROBOFLOW_TIMEOUT_SECONDS=20
ROBOCHESS_ROBOFLOW_RETRIES=0
